// [HEARING_XLSX_V1 2026-10-29]
// Gemini はスプレッドシートを直接作れない（空ファイルしか作れずCSVを手貼りさせる羽目になる）。
// → サーバー側で exceljs を使い、必要なシートだけを含む .xlsx を生成して直接ダウンロードさせる。
//    Googleドライブにそのままアップすればスプレッドシートとして開ける。
//
// 社内用の列は hearingSheetDefs.ts の生成時点で除去済み。
import { NextRequest, NextResponse } from 'next/server'
import ExcelJS from 'exceljs'
import { HEARING_SHEET_DEFS } from '@/lib/hearingSheetDefs'

export const runtime = 'nodejs'

type Body = {
  sheets: string[]                       // 作成するシート名（順番どおり）
  info?: Record<string, string>          // 表紙に載せる案件情報
  prefill?: Record<string, string>       // 必須確認①などの事前チェック内容
}

export async function POST(req: NextRequest) {
  let body: Body
  try {
    body = await req.json()
  } catch {
    return NextResponse.json({ error: 'invalid json' }, { status: 400 })
  }
  const sheets = Array.isArray(body.sheets) ? body.sheets : []
  if (!sheets.length) return NextResponse.json({ error: 'sheets is empty' }, { status: 400 })

  const wb = new ExcelJS.Workbook()
  wb.creator = 'KUJIRA Support'
  wb.created = new Date()

  // ---------- 表紙 ----------
  const cover = wb.addWorksheet('表紙')
  cover.columns = [{ width: 22 }, { width: 86 }]
  const info = body.info || {}
  const coverRows: [string, string][] = [
    ['書類名', 'AdvaNceD IoT スマートチェックイン 導入時ヒアリングシート'],
    ['貴社名', info.client || ''],
    ['設置住所', info.address || ''],
    ['ご担当者様', info.contact || ''],
    ['納品予定日', info.due || ''],
    ['導入機材・構成', info.equipment || ''],
    ['', ''],
    ['ご案内とお願い',
      'この度は「AdvaNceD IoT スマートチェックイン」をご導入いただき、誠にありがとうございます。' +
      '本シートはシステム初期設定・機器キッティングを円滑に進めるための確認用ヒアリングシートです。' +
      '黄色の欄にご回答・チェックをお願いいたします。'],
    ['収録シート', sheets.map((s, i) => `${i + 1}. ${s}`).join(' / ')],
  ]
  coverRows.forEach(([k, v]) => {
    const r = cover.addRow([k, v])
    r.getCell(1).font = { bold: true }
    r.getCell(2).alignment = { wrapText: true, vertical: 'top' }
  })
  cover.getRow(1).font = { bold: true, size: 14 }

  // ---------- 各シート ----------
  const YELLOW: ExcelJS.Fill = {
    type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFF9C4' },
  }
  const prefill = body.prefill || {}

  for (const name of sheets) {
    const def = HEARING_SHEET_DEFS[name]
    const ws = wb.addWorksheet(name.slice(0, 31))
    if (!def || !def.length) {
      ws.addRow([`【${name}】の定義が未登録です`])
      ws.addRow(['雛形スプレッドシートの該当シートを転記してください。'])
      continue
    }

    // [HEARING_XLSX_V5 2026-10-29] 列幅。雛形の列位置を保持した定義を前提にする。
    //   A列=大見出し/説明文, B列=設問, D列=設問(2段目), L列=ご回答欄
    const ANS = 12                                   // L列 = ご回答欄
    const maxCols = Math.max(...def.map(r => r.length), ANS)
    // [HEARING_XLSX_V7] A〜K は結合して1つの文章枠として使うので、
    //   合計で読める幅になるよう配分する（A=インデント, B以降=本文）。
    ws.columns = Array.from({ length: maxCols }, (_, i) => {
      if (i === 0) return { width: 3 }               // インデント用
      if (i === 1) return { width: 10 }
      if (i === 2) return { width: 3 }
      if (i >= 3 && i <= ANS - 2) return { width: 9 }  // D〜K（結合して本文になる）
      if (i === ANS - 1) return { width: 24 }        // L ご回答欄
      return { width: 40 }                            // M以降 備考
    })

    const merges: Array<[number, number, number]> = []

    def.forEach((row, ri) => {
      const vals = row.map(c => {
        const hit = Object.keys(prefill).find(k => c.includes(k))
        if (c === '□' && hit) return prefill[hit] === 'TRUE' ? '✔' : '□'
        return c
      })

      // --- [HEARING_XLSX_V7] テキストセルを次のテキストの手前まで結合する ---
      //   CSVには結合情報が無く値は1セルだけなので、そのままだと細い列に
      //   長文が入って潰れる。雛形と同じく横に広げて読めるようにする。
      {
        const textIdx: number[] = []
        vals.forEach((v, idx) => { if (v) textIdx.push(idx) })
        for (let n = 0; n < textIdx.length; n++) {
          const cur = textIdx[n]
          const next = textIdx[n + 1]
          const v = vals[cur]
          if (v === '□' || v === '✔') continue        // 回答欄は結合しない
          // 結合の右端: 次のテキストの手前、無ければ回答欄(L)の手前
          let end = (next !== undefined ? next - 1 : ANS - 2)
          if (cur >= ANS - 1) end = cur                // L列以降は結合しない
          if (end > cur) merges.push([ri + 1, cur + 1, end + 1])
        }
      }

      const r = ws.addRow(vals)
      r.alignment = { wrapText: true, vertical: 'middle' }

      r.eachCell({ includeEmpty: false }, (cell, col) => {
        const v = String(cell.value ?? '')
        if (!v) return
        if (v === '□' || v === '✔') {
          cell.fill = YELLOW
          cell.alignment = { horizontal: 'center', vertical: 'middle' }
          cell.border = {
            top: { style: 'thin' }, bottom: { style: 'thin' },
            left: { style: 'thin' }, right: { style: 'thin' },
          }
          cell.font = { size: 12, bold: true }
          return
        }
        if (ri === 0) {                               // シート見出し
          cell.font = { bold: true, size: 13 }
          return
        }
        if (/^\s*\d+\.\s/.test(v)) {                 // 1. 2. の大見出し
          cell.font = { bold: true, size: 11 }
          cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFDCE6F1' } }
          return
        }
        if (v.startsWith('※') || v.startsWith('・') || v.startsWith('AdvaNceD')) {
          cell.font = { size: 9, color: { argb: 'FF666666' } }   // 説明文
          return
        }
        if (col >= ANS + 1) {
          cell.font = { size: 9, color: { argb: 'FF666666' } }   // 備考列
        }
      })

      // 行高は内容量から推定（折り返しが潰れないように）
      const longest = Math.max(...vals.map(v => (v || '').length), 0)
      if (longest > 60) r.height = Math.min(90, 16 + Math.ceil(longest / 60) * 14)
    })

    for (const [row, c1, c2] of merges) {
      try { ws.mergeCells(row, c1, row, c2) } catch { /* 既に結合済みなら無視 */ }
    }
    ws.views = [{ state: 'frozen', ySplit: 1 }]
  }

  const buf = await wb.xlsx.writeBuffer()
  const fname = `hearing_${(info.client || 'sheet').replace(/[\\/:*?"<>|]/g, '')}_${new Date().toISOString().slice(0, 10)}.xlsx`
  return new NextResponse(buf as ArrayBuffer, {
    status: 200,
    headers: {
      'Content-Type': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
      'Content-Disposition': `attachment; filename*=UTF-8''${encodeURIComponent(fname)}`,
    },
  })
}
