<!--
  ヒアリングシート コピー作成ダイアログ
  --------------------------------------------------
  Apps Script のファイル名を「dialog」にして貼り付けてください。
  （Apps Script エディタ左の「＋」→ HTML → 名前を dialog にする）

  [V2 2026-10-29] 案件情報を貼り付けると機材チェックが自動で入るようにした。
                  ダッシュボードの「📋 設定をコピー」で得た文字列を貼るだけ。
-->
<!DOCTYPE html>
<html>
<head>
<base target="_top">
<style>
 body{font-family:"Helvetica Neue",Arial,"Hiragino Sans","Meiryo",sans-serif;font-size:14px;padding:14px;color:#222}
 h3{margin:0 0 10px;font-size:16px}
 label{display:block;margin:7px 0 2px;font-weight:bold;font-size:13px;color:#555}
 input[type=text],textarea{width:100%;padding:7px;border:1px solid #ccc;border-radius:4px;box-sizing:border-box;font-size:13px}
 textarea{height:54px;font-family:monospace;font-size:11px}
 .chk{display:flex;align-items:center;gap:7px;padding:4px 0}
 .chk label{margin:0;font-weight:normal;font-size:14px}
 .box{border:1px solid #ddd;border-radius:6px;padding:9px;margin-top:9px;max-height:230px;overflow:auto}
 button{margin-top:12px;width:100%;padding:11px;background:#0b8043;color:#fff;border:0;border-radius:5px;font-weight:bold;font-size:15px;cursor:pointer}
 button:disabled{background:#999}
 #paste{background:#1a73e8;margin-top:6px;padding:8px;font-size:13px}
 #msg{margin-top:10px;font-size:13px;line-height:1.6}
 a{color:#1a73e8}
 .hint{font-size:12px;color:#888;margin-top:3px}
</style>
</head>
<body>
<h3>必要シートだけコピー作成</h3>

<label>① ダッシュボードの「📋 設定をコピー」した内容を貼り付け</label>
<textarea id="json" placeholder='ここに貼り付けると、下の項目が自動で埋まります'></textarea>
<button id="paste" onclick="applyJson()">⬇ 貼り付けた内容を反映</button>
<div class="hint">※ 手入力したい場合はこの欄を空のまま、下を直接入力してください</div>

<label>会社名</label>
<input type="text" id="client" placeholder="株式会社ビジョン">
<label>物件名・住所</label>
<input type="text" id="property" placeholder="〒656-2401 兵庫県淡路市岩屋2604">
<label>ご担当者</label>
<input type="text" id="contact" placeholder="石川様">
<label>電話番号</label>
<input type="text" id="tel" placeholder="0799-00-0000">
<label>メールアドレス</label>
<input type="text" id="email" placeholder="info@example.com">
<label>客室数</label>
<input type="text" id="rooms" placeholder="20">
<label>PMS名</label>
<input type="text" id="pms" placeholder="suitebook">
<label>カードキーのメーカー</label>
<input type="text" id="cardkeyMaker" placeholder="MIWA">
<label>スマートロックのメーカー</label>
<input type="text" id="lockMaker" placeholder="EPIC">

<div class="box">
  <div style="font-weight:bold;font-size:13px;margin-bottom:5px">導入する機材（チェックしたシートを残します）</div>
  <div class="chk"><input type="checkbox" id="chk_pms"><label for="chk_pms">PMS</label></div>
  <div class="chk"><input type="checkbox" id="chk_smartlock"><label for="chk_smartlock">スマートロック（①②）</label></div>
  <div class="chk"><input type="checkbox" id="chk_cardkey"><label for="chk_cardkey">カードキー</label></div>
  <div class="chk"><input type="checkbox" id="chk_cylinder"><label for="chk_cylinder">シリンダー錠</label></div>
  <div class="chk"><input type="checkbox" id="chk_cash"><label for="chk_cash">現金決済</label></div>
  <div class="chk"><input type="checkbox" id="chk_p400"><label for="chk_p400">端末カード決済（P400）</label></div>
  <div class="chk"><input type="checkbox" id="chk_sumaho" checked><label for="chk_sumaho">スマホカード決済</label></div>
  <div class="chk"><input type="checkbox" id="chk_paypay" checked><label for="chk_paypay">PayPay決済</label></div>
  <div class="chk"><input type="checkbox" id="chk_printer"><label for="chk_printer">プリンタ</label></div>
  <div class="chk"><input type="checkbox" id="chk_roomtablet"><label for="chk_roomtablet">ルームタブレット</label></div>
  <div class="chk"><input type="checkbox" id="chk_precheckin" checked><label for="chk_precheckin">事前チェックイン</label></div>
  <div class="chk"><input type="checkbox" id="chk_frontci" checked><label for="chk_frontci">フロントチェックイン</label></div>
  <div class="hint">※ 必須確認①②③は常に残ります</div>
  <div class="hint" style="color:#b8860b">※ PayPay決済 / スマホカード決済 / フロントチェックイン は
    機材構成から判断できないため既定でONです。不要ならチェックを外してください</div>
</div>

<button id="go" onclick="run()">コピーを作成</button>
<div id="msg"></div>

<script>
var KEYS = ['pms','smartlock','cardkey','cylinder','cash','p400','sumaho','paypay','printer','roomtablet','precheckin','frontci'];

/** ダッシュボードからコピーしたJSONを反映する */
function applyJson(){
  var raw = document.getElementById('json').value.trim();
  if(!raw){ alert('貼り付け欄が空です'); return; }
  var d;
  try { d = JSON.parse(raw); }
  catch(e){ alert('形式が正しくありません。ダッシュボードの「📋 設定をコピー」で取得した内容を貼り付けてください'); return; }

  ['client','property','contact','tel','email','rooms','pms','cardkeyMaker','lockMaker']
    .forEach(function(k){ if(d[k]) document.getElementById(k).value = d[k]; });

  // [V9] チェックボックスの id は chk_ 付き（テキスト欄との衝突を避けるため）
  var on = [];
  KEYS.forEach(function(k){
    var el = document.getElementById('chk_' + k);
    if(!el) return;
    var v = !!(d.equips && d.equips.indexOf(k) >= 0);
    el.checked = v;
    if(v) on.push(k);
  });
  document.getElementById('msg').innerHTML =
    '<b style="color:#0b8043">✅ 反映しました</b>（機材 ' + on.length + '件にチェック）';
}

var timer = null, sec = 0;

/** 経過秒数と工程の目安を出す */
function tick(){
  sec++;
  var step = sec < 8  ? '雛形をコピー中'
           : sec < 25 ? '不要なシートを削除中'
           :            '案件情報を入力中';
  document.getElementById('msg').innerHTML =
    '<b style="color:#1a73e8">⏳ ' + step + '…（' + sec + '秒）</b><br>' +
    '<span style="color:#888;font-size:12px">' +
    '全部で30〜60秒ほどかかります。この画面は閉じないでください</span>';
}

function run(){
  var btn = document.getElementById('go');
  btn.disabled = true; btn.textContent = '作成中…';
  sec = 0;
  if(timer) clearInterval(timer);
  timer = setInterval(tick, 1000);
  tick();
  var equips = KEYS.filter(function(k){
    var el = document.getElementById('chk_' + k);
    return el && el.checked;
  });
  google.script.run
    .withSuccessHandler(done)
    .withFailureHandler(fail)
    .createCopy({
      client:       document.getElementById('client').value,
      property:     document.getElementById('property').value,
      contact:      document.getElementById('contact').value,
      tel:          document.getElementById('tel').value,
      email:        document.getElementById('email').value,
      rooms:        document.getElementById('rooms').value,
      pms:          document.getElementById('pms').value,
      cardkeyMaker: document.getElementById('cardkeyMaker').value,
      lockMaker:    document.getElementById('lockMaker').value,
      equips:       equips
    });
}
function done(r){
  if(timer) clearInterval(timer);
  var btn = document.getElementById('go');
  btn.disabled = false; btn.textContent = 'コピーを作成';
  document.getElementById('msg').innerHTML =
    '<div style="background:#e6f4ea;border:1px solid #0b8043;border-radius:6px;padding:10px">' +
    '<b style="color:#0b8043;font-size:15px">✅ 完成しました（' + sec + '秒）</b><br>' +
    '<span style="font-size:12px;color:#555">' +
    '残したシート ' + r.kept.length + '枚 / 削除 ' + r.removed.length + '枚 / ' +
    '自動入力 ' + (r.filled || 0) + '箇所</span>' +
    '<div style="margin-top:8px;padding-top:8px;border-top:1px solid #b7dfc4">' +
    '<b style="font-size:14px">▼ このあとの手順</b><br>' +
    '<a href="' + r.url + '" target="_blank" ' +
    'style="display:inline-block;margin:6px 0;padding:8px 12px;background:#1a73e8;color:#fff;' +
    'border-radius:4px;text-decoration:none;font-weight:bold">▶ 作成したシートを開く</a><br>' +
    '<span style="font-size:12px;color:#555">' +
    '① 開いて内容を確認（空欄はお客様に記入いただく項目です）<br>' +
    '② 右上「共有」またはダウンロードしてお客様へ送付<br>' +
    '③ ダッシュボードの「✉️ 送付メール」から本文をコピーして送信<br>' +
    '保存先: マイドライブ直下「' + r.name + '」</span>' +
    '</div></div>';
}
function fail(e){
  if(timer) clearInterval(timer);
  var btn = document.getElementById('go');
  btn.disabled = false; btn.textContent = 'コピーを作成';
  document.getElementById('msg').innerHTML =
    '<b style="color:#c00">❌ 失敗: ' + e.message + '</b>';
}
</script>
</body>
</html>
