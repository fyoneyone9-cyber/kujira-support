  ['\u30b9\u30de\u30fc\u30c8\u30ed\u30c3\u30af', 'smartlock'],
  ['\u30ad\u30fc\u30dc\u30c3\u30af\u30b9', 'keybox'],
  ['\u5353\u4e0a', 'kiosk_desk'],
  ['KIOSK', 'kiosk'],
  ['\u30eb\u30fc\u30e0\u30bf\u30d6\u30ec\u30c3\u30c8', 'roomtablet'],
