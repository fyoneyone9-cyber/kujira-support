/** 区分の表記ゆれに備えたキーワード判定（CAT_KEYS に無い場合の保険） */
var CAT_KEYWORDS = [
  ['\u5171\u901a', 'always'],
  ['\u30c1\u30a7\u30c3\u30af\u30a4\u30f3\u30b7\u30b9\u30c6\u30e0', 'always'],
  ['\u88dc\u52a9\u91d1', 'hojokin'],
