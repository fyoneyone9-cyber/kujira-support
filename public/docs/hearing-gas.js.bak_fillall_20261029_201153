/**
 * ヒアリングシート 必要シートだけコピー作成
 * ------------------------------------------------------------------
 * 雛形スプレッドシートを丸ごとコピーし、不要なシートを削除する方式。
 * 書式・結合・色・列幅がすべて original のまま残るので完全に一致する。
 *
 * 【設置方法】
 *   1. 雛形スプレッドシートを開く
 *   2. 拡張機能 → Apps Script
 *   3. 中身を全部消してこのコードを貼り付け
 *   4. 保存（💾）
 *   5. 雛形を再読み込み → メニューに「📋 ヒアリングシート」が出る
 */

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('📋 ヒアリングシート')
    .addItem('必要シートだけコピー作成', 'showDialog')
    .addToUi();
}

/** 機材 → 必要シート の対応。ダッシュボードの判定と同じ。 */
var EQUIP_SHEETS = {
  pms:        ['PMS'],
  smartlock:  ['スマートロック①', 'スマートロック②'],
  cardkey:    ['カードキー'],
  cylinder:   ['シリンダー錠'],
  cash:       ['現金決済'],
  p400:       ['端末カード決済'],
  sumaho:     ['スマホカード決済'],
  paypay:     ['PayPay決済'],
  printer:    ['プリンタ'],
  roomtablet: ['ルームタブレット'],
  frontci:    ['フロントチェックイン'],
  precheckin: ['事前チェックイン']
};

/** 常に残すシート */
var ALWAYS = ['必須確認①', '必須確認②', '必須確認③'];

function showDialog() {
  var html = HtmlService.createHtmlOutputFromFile('dialog')
    .setWidth(420).setHeight(560);
  SpreadsheetApp.getUi().showModalDialog(html, '必要シートだけコピー作成');
}

/**
 * 実際にコピーを作る。
 * @param {Object} p {client, property, contact, due, equips:[key...]}
 */
function createCopy(p) {
  var src = SpreadsheetApp.getActiveSpreadsheet();

  // 残すシート名を決める
  var keep = {};
  ALWAYS.forEach(function (n) { keep[n] = true; });
  (p.equips || []).forEach(function (k) {
    (EQUIP_SHEETS[k] || []).forEach(function (n) { keep[n] = true; });
  });

  // 雛形を丸ごとコピー（書式・結合・色がそのまま残る）
  var name = 'ヒアリングシート_' + (p.client || '') + '_' +
    Utilities.formatDate(new Date(), 'JST', 'yyyyMMdd');
  var copy = src.copy(name);

  // 不要シートを削除
  var removed = [];
  copy.getSheets().forEach(function (sh) {
    var n = sh.getName();
    if (!keep[n]) {
      try { copy.deleteSheet(sh); removed.push(n); } catch (e) {}
    }
  });

  // 案件情報を自動入力（必須確認②）
  try { fillInfo(copy, p); } catch (e) {}

  return {
    url: copy.getUrl(),
    name: name,
    kept: Object.keys(keep).filter(function (n) {
      return copy.getSheetByName(n) !== null;
    }),
    removed: removed
  };
}

/** 必須確認②に案件情報を書き込む（項目名で行を探す） */
function fillInfo(ss, p) {
  var sh = ss.getSheetByName('必須確認②');
  if (!sh) return;
  var zip = '', addr = p.property || '';
  var m = addr.match(/〒?\s*(\d{3}-?\d{4})/);
  if (m) { zip = m[1]; addr = addr.replace(m[0], '').trim(); }

  var MAP = [
    ['組織名', p.client],
    ['DMSにログインされる方のお名前', p.contact],
    ['物件名', addr],
    ['物件の住所', addr],
    ['物件の郵便番号', zip],
    ['お電話番号', p.tel]
  ];

  var last = sh.getLastRow();
  var values = sh.getRange(1, 1, last, sh.getLastColumn()).getValues();

  // 「ご回答欄」の列を特定
  var ansCol = 0;
  for (var r = 0; r < Math.min(6, values.length); r++) {
    for (var c = 0; c < values[r].length; c++) {
      if (String(values[r][c]).indexOf('ご回答欄') >= 0) { ansCol = c + 1; break; }
    }
    if (ansCol) break;
  }
  if (!ansCol) return;

  for (var r2 = 0; r2 < values.length; r2++) {
    var rowText = values[r2].join(' ');
    for (var i = 0; i < MAP.length; i++) {
      var key = MAP[i][0], val = MAP[i][1];
      if (!val) continue;
      if (rowText.indexOf(key) >= 0) {
        var cur = sh.getRange(r2 + 1, ansCol).getValue();
        if (!cur) sh.getRange(r2 + 1, ansCol).setValue(val);
        break;
      }
    }
  }
}
